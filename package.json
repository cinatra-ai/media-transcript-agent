{
  "name": "@cinatra-ai/media-transcript-agent",
  "version": "0.1.5",
  "license": "Apache-2.0",
  "description": "Transcribes audio or video URLs (including YouTube watch URLs) to text with [Speaker N]: markers. Routes via /api/llm-bridge to Gemini (preferredProvider in OAS metadata).",
  "type": "module",
  "files": [
    "cinatra"
  ],
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Media Transcript Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/text-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "media-transcript-flow",
    "sourceVersionId": "f7d1d24a-30b7-4699-a476-5b7e42dd088b",
    "sourceVersionNumber": 1,
    "type": "flow",
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null,
    "consumes": [],
    "produces": [
      {
        "extension": "@cinatra-ai/text-artifact",
        "objectTypeId": "@cinatra-ai/text-artifact:artifact"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
